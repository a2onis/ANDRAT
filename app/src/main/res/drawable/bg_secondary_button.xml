<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#E5ECE9" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="#D2DEDA" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#DCEDE9" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/teal" /></shape>
    </item>
    <item>
        <shape><solid android:color="#F8FBFA" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/line" /></shape>
    </item>
</selector>
